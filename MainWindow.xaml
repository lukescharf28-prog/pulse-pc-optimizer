<Window x:Class="Pulse.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Pulse" Title="Pulse · PC Optimizer" Width="1240" Height="920" MinWidth="1000" MinHeight="730" WindowStartupLocation="CenterScreen" Background="#0F131B" Foreground="#ECF0F5" FontFamily="Segoe UI" Loaded="OnLoaded">
 <Grid Background="#0F131B">
  <Grid.ColumnDefinitions><ColumnDefinition Width="216"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#131821" BorderBrush="#272E39" BorderThickness="0,0,1,0">
   <Grid Margin="18,30,18,22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="12,0,0,19"><StackPanel Orientation="Horizontal"><Border Background="#C5F277" Width="32" Height="32" CornerRadius="9"><TextBlock Text="ϟ" Foreground="#19200F" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,-5,0,0"/></Border><TextBlock Text="pulse" FontSize="29" FontWeight="Bold" Margin="10,-5,0,0"/></StackPanel><TextBlock Text="PC OPTIMIZER" Foreground="#738092" FontSize="10" Margin="43,5,0,0"/></StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel><TextBlock Text="WORKSPACE" FontSize="10" Foreground="#647084" Margin="16,0,0,12"/>
     <Button x:Name="NavOverview" Style="{StaticResource Nav}" Tag="overview" Click="Navigate" Content="◫    Übersicht"/>
     <Button x:Name="NavRam" Style="{StaticResource Nav}" Tag="ram" Click="Navigate" Content="▤    Memory Reducer"/>
     <Button x:Name="NavGpu" Style="{StaticResource Nav}" Tag="gpu" Click="Navigate" Content="◈    GPU &amp; VRAM"/>
     <Button x:Name="NavProcesses" Style="{StaticResource Nav}" Tag="processes" Click="Navigate" Content="☷    Prozesse"/>
     <Button x:Name="NavPerformance" Style="{StaticResource Nav}" Tag="performance" Click="Navigate" Content="▥    Live-Leistung"/>
     <Button x:Name="NavApps" Style="{StaticResource Nav}" Tag="apps" Click="Navigate" Content="▦    Apps &amp; Spiele"/>
     <Button x:Name="NavSpeed" Style="{StaticResource Nav}" Tag="speed" Click="Navigate" Content="⇅    Speedtest"/>
     <Button x:Name="NavUpdates" Style="{StaticResource Nav}" Tag="updates" Click="Navigate" Content="↻    Updates"/>
     <Button x:Name="UpdateBadge" Content="Update verfügbar ↗" Tag="updates" Click="Navigate" Style="{StaticResource Primary}" Visibility="Collapsed" Margin="0,6"/>
     <Border Background="#2A313C" Height="1" Margin="14,12"/>
     <Button x:Name="NavSettings" Style="{StaticResource Nav}" Tag="settings" Click="Navigate" Content="⚙    Einstellungen"/>
    </StackPanel></ScrollViewer>
    <Border Grid.Row="2" Background="#1B2421" CornerRadius="11" Padding="15"><StackPanel><TextBlock Text="●  Lokal. Unter deiner Kontrolle." FontSize="11" Foreground="#C5F277" TextWrapping="Wrap"/><TextBlock Text="Keine Werbung · Du entscheidest" Foreground="#85958C" FontSize="10" Margin="0,7,0,0"/><TextBlock Text="PULSE / VERSION 1.1" Foreground="#64776A" FontSize="9" Margin="0,16,0,0"/></StackPanel></Border>
   </Grid>
  </Border>
  <Grid Grid.Column="1" Margin="32,27,32,18">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="0,0,0,24"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="PageEyebrow" Text="DEIN PC. IM BLICK." Foreground="#8D97A7" FontSize="10"/><TextBlock x:Name="PageTitle" Text="Mehr Raum für das Wesentliche." FontSize="26" FontWeight="SemiBold" Margin="0,8,12,0" TextTrimming="CharacterEllipsis"/></StackPanel><Border Grid.Column="1" VerticalAlignment="Center" CornerRadius="18" BorderBrush="#35423A" BorderThickness="1" Padding="13,8"><TextBlock x:Name="LiveLabel" Text="●  LIVE  ·  3 s" Foreground="#C5F277" FontSize="11"/></Border></Grid>
   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel>
     <StackPanel x:Name="MetricsPanel">
      <UniformGrid Columns="3" Margin="0,0,0,18">
       <Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="ARBEITSSPEICHER" FontSize="10" Foreground="#A1ABBA"/><StackPanel Orientation="Horizontal" Margin="0,12,0,0"><TextBlock x:Name="RamValue" Text="—" FontSize="31" FontWeight="SemiBold"/><TextBlock Text="belegt" Foreground="#929AA9" Margin="8,19,0,0" FontSize="11"/></StackPanel><ProgressBar x:Name="RamBar" Maximum="100" Height="4" Foreground="#C5F277" Background="#2B3340" BorderThickness="0" Margin="0,15,0,10"/><TextBlock x:Name="RamDetail" Text="Messwerte werden geladen …" FontSize="11" Foreground="#929AA9"/></StackPanel></Border>
       <Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="PROZESSOR" FontSize="10" Foreground="#A1ABBA"/><StackPanel Orientation="Horizontal" Margin="0,12,0,0"><TextBlock x:Name="CpuValue" Text="—" FontSize="31" FontWeight="SemiBold"/><TextBlock Text="Auslastung" Foreground="#929AA9" Margin="8,19,0,0" FontSize="11"/></StackPanel><ProgressBar x:Name="CpuBar" Maximum="100" Height="4" Foreground="#81B6FF" Background="#2B3340" BorderThickness="0" Margin="0,15,0,10"/><TextBlock x:Name="CpuDetail" FontSize="11" Foreground="#929AA9"/></StackPanel></Border>
       <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="GRAFIKSPEICHER" FontSize="10" Foreground="#A1ABBA"/><TextBlock x:Name="GpuValue" Text="—" FontSize="31" FontWeight="SemiBold" Margin="0,12,0,0"/><TextBlock x:Name="GpuDetail" Text="Dedizierter Speicher · alle GPUs" TextWrapping="Wrap" FontSize="11" Foreground="#929AA9" Margin="0,19,0,0"/></StackPanel></Border>
      </UniformGrid>
     </StackPanel>
     <StackPanel x:Name="OverviewPanel">
      <Border Style="{StaticResource Card}" Padding="27" Margin="0,0,0,18">
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,30,0"><TextBlock Text="WENIGER BALLAST. MEHR FOKUS." Foreground="#C5F277" FontSize="10"/><TextBlock Text="Dein Speicher.&#10;Deine Entscheidung." FontSize="30" FontWeight="SemiBold" Margin="0,12,0,10"/><TextBlock Text="Finde Speicherverbraucher und gib RAM gezielt frei. Du entscheidest, welche Apps bleiben." Foreground="#9FA9B7" TextWrapping="Wrap" LineHeight="21"/><Button Content="Memory Reducer öffnen   ↗" Style="{StaticResource Primary}" HorizontalAlignment="Left" Margin="0,22,0,0" Tag="ram" Click="Navigate"/></StackPanel>
        <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid><TextBlock Text="RAM-VERLAUF" Foreground="#9CA7B6" FontSize="10"/><TextBlock Text="●  BELEGT" Foreground="#C5F277" FontSize="10" HorizontalAlignment="Right"/></Grid><local:HistoryChart x:Name="RamChart" Grid.Row="1" Height="146" Margin="0,12,0,12"/><Grid Grid.Row="2"><TextBlock Text="Letzte 60 Messungen" FontSize="10" Foreground="#727F91"/><TextBlock x:Name="RamFree" Text="— GB verfügbar" HorizontalAlignment="Right" FontSize="11" Foreground="#C5F277"/></Grid></Grid>
       </Grid>
      </Border>
      <UniformGrid Columns="2" Margin="0,0,0,18">
       <Border Style="{StaticResource Card}" Margin="0,0,12,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="◈   GPU aufräumen" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="VRAM-Verbraucher finden und schließen." Foreground="#929AA9" TextWrapping="Wrap" FontSize="12" Margin="0,10,14,0"/></StackPanel><Button Grid.Column="1" Content="↗" Tag="gpu" Click="Navigate" VerticalAlignment="Center" ToolTip="GPU und VRAM öffnen"/></Grid></Border>
       <Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="☷   Prozesse im Blick" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Prüfen, was im Hintergrund läuft." Foreground="#929AA9" TextWrapping="Wrap" FontSize="12" Margin="0,10,14,0"/></StackPanel><Button Grid.Column="1" Content="↗" Tag="processes" Click="Navigate" VerticalAlignment="Center" ToolTip="Prozessübersicht öffnen"/></Grid></Border>
      </UniformGrid>
      <Border Style="{StaticResource Card}" Padding="21"><StackPanel><TextBlock Text="Letzte Aktivitäten" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12"/><ItemsControl x:Name="ActivityList"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="#A1ACBA" FontSize="12" TextWrapping="Wrap" Margin="0,5"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
     </StackPanel>
     <StackPanel x:Name="ProcessPanel" Visibility="Collapsed">
      <Border Style="{StaticResource Card}" Margin="0,0,0,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,25,0"><TextBlock x:Name="ActionTitle" FontSize="21" FontWeight="SemiBold"/><TextBlock x:Name="ActionDescription" Foreground="#A2ACBA" TextWrapping="Wrap" Margin="0,10,0,0" LineHeight="20"/><Button x:Name="BatchTrimButton" Content="Hintergrund-RAM reduzieren …" Click="TrimBackground" HorizontalAlignment="Left" Margin="0,18,0,0" Visibility="Collapsed"/></StackPanel><StackPanel Grid.Column="1" VerticalAlignment="Center"><Button x:Name="TrimButton" Content="RAM reduzieren" Style="{StaticResource Primary}" Click="TrimSelected" Margin="0,0,0,8"/><Button x:Name="CloseButton" Content="App schließen" Click="CloseSelected" Margin="0,0,0,8"/><Button x:Name="KillButton" Content="Beenden erzwingen …" Foreground="#EBA7A7" Visibility="Collapsed" IsEnabled="False"/></StackPanel></Grid></Border>
      <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="SearchBox" TextChanged="SearchChanged" ToolTip="Nach Prozessname oder PID suchen" AutomationProperties.Name="Prozess suchen"/><TextBlock Text="Name oder PID suchen …" IsHitTestVisible="False" Margin="13,10" Foreground="#738094" x:Name="SearchPlaceholder"/><Button Grid.Column="1" Content="Aktualisieren" Click="RefreshClick" Margin="12,0,0,0"/></Grid>
      <Border CornerRadius="12" BorderBrush="#2A313D" BorderThickness="1" ClipToBounds="True"><DataGrid x:Name="ProcessGrid" Height="300" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="None" Background="#171C25" BorderThickness="0" RowHeaderWidth="0" SelectionMode="Single" SelectionUnit="FullRow" SelectionChanged="SelectionChanged" RowHeight="45" FontSize="12" ScrollViewer.HorizontalScrollBarVisibility="Auto"><DataGrid.Columns>
       <DataGridTextColumn Header="PROZESS" Binding="{Binding Name}" Width="170"/>
       <DataGridTextColumn Header="PID" Binding="{Binding Id}" Width="70"/>
       <DataGridTextColumn Header="CPU" Binding="{Binding CpuText}" SortMemberPath="CpuPercent" Width="85"/><DataGridTextColumn Header="GPU" Binding="{Binding LoadText}" SortMemberPath="GpuPercent" Width="85"/><DataGridTextColumn Header="I/O¹" Binding="{Binding IoText}" SortMemberPath="IoBytes" Width="110"/><DataGridTextColumn Header="RAM" Binding="{Binding RamText}" SortMemberPath="Ram" Width="105"/>
       <DataGridTextColumn Header="VRAM¹" Binding="{Binding GpuText}" SortMemberPath="Gpu" Width="105"/>
       <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="145"/>
      </DataGrid.Columns></DataGrid></Border>
      <TextBlock x:Name="ListNote" Foreground="#8792A3" FontSize="11" Margin="2,12,0,15" TextWrapping="Wrap" LineHeight="18"/>
      <Border Background="#1B211D" BorderBrush="#34422C" BorderThickness="1" CornerRadius="11" Padding="18"><TextBlock x:Name="SafetyNote" Foreground="#BAC9AB" FontSize="12" TextWrapping="Wrap" LineHeight="19"/></Border>
     </StackPanel>
     <StackPanel x:Name="ExtraPanels"/>
     <StackPanel x:Name="SettingsPanel" Visibility="Collapsed">
      <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="Live-Monitoring" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Aktualisierungsintervall" Foreground="#9DA8B7" Margin="0,20,0,10"/><StackPanel Orientation="Horizontal"><Button Content="1 Sekunde" Tag="1" Click="SetInterval" Margin="0,0,10,0"/><Button Content="3 Sekunden" Tag="3" Click="SetInterval" Margin="0,0,10,0"/><Button Content="5 Sekunden" Tag="5" Click="SetInterval" Margin="0,0,10,0"/><Button Content="10 Sekunden" Tag="10" Click="SetInterval"/></StackPanel><CheckBox x:Name="PauseMinimized" Content="Monitoring pausieren, wenn das Fenster minimiert ist" Margin="0,20,0,0" IsChecked="True" Checked="SaveSettings" Unchecked="SaveSettings"/></StackPanel></Border>
      <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="Windows-Werkzeuge" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Weitere Stellschrauben direkt in Windows öffnen." Foreground="#929AA9" Margin="0,9,0,18"/><WrapPanel><Button Content="Autostart-Apps ↗" Tag="ms-settings:startupapps" Click="OpenSettings" Margin="0,0,10,10"/><Button Content="Grafikeinstellungen ↗" Tag="ms-settings:display-advancedgraphics" Click="OpenSettings" Margin="0,0,10,10"/><Button Content="Energie &amp; Akku ↗" Tag="ms-settings:powersleep" Click="OpenSettings" Margin="0,0,10,10"/></WrapPanel></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Du behältst die Kontrolle." FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Pulse selbst benötigt keine Administratorrechte. Es beendet keine Apps automatisch. Windows-/Microsoft-Komponenten, Treiber und andere Sitzungen sind gesperrt. Deinstallationen erfolgen im Herstellerdialog; dabei kann Windows Administratorrechte verlangen. Speedtest und Update-Prüfung verbinden sich mit Cloudflare bzw. GitHub.&#10;&#10;RAM-Reduktion kann beim nächsten Zugriff Nachladen auslösen. VRAM wird vom Grafiktreiber verwaltet; schließe dafür gezielt nicht benötigte Programme. Bei integrierten GPUs kann dedizierter VRAM 0 sein.&#10;&#10;Pulse 1.1 · Windows 10/11 · x64" TextWrapping="Wrap" LineHeight="22" Foreground="#A2ACBA" Margin="0,15,0,0"/></StackPanel></Border>
     </StackPanel>
    </StackPanel>
   </ScrollViewer>
   <Border Grid.Row="2" BorderBrush="#2B323E" BorderThickness="0,1,0,0" Margin="0,18,0,0" Padding="0,13,0,0"><TextBlock x:Name="StatusText" Text="Pulse startet …" Foreground="#8D99AA" FontSize="11" TextWrapping="Wrap"/></Border>
  </Grid>
 </Grid>
</Window>
